@startuml incident_periodic_review

<style>
element {
    MaximumWidth 190
}
</style>


skinparam shadowing false
skinparam dpi 150

skinparam activity {
    BackgroundColor White
    BorderColor Black
    FontSize 12
}



|Management|
|Safety|

start

:1. Déclenchement de la Periodic Review;

:2. Analyse du statut d'un incident par rapport a ses mesures;

:3. Addition d'un commentaire [PERIODIC REVIEW];

if (4. Toutes les mesures sont fermées et considerées efficaces ?) then (Oui)

    if (5. Proposition de fermeture de l'incident au Reporter ?) then (Oui)

        |Management|

        :6. Analyse de la proposition de fermeture;

        if (7. Proposition fermeture acceptee ?) then (Oui)

            |Safety|

            :8. Mise a jour du statut de l'incident;

            stop

        else (Non)

            |Management|

            stop

        endif

    else (Non)

        |Safety|

        stop

    endif

endif
->Non;
if (9. Besoin d'ajouter et/ou de supprimer une ou des mesures et proposition associée ?) then (Oui)

        |Management|

        :10. Analyse de la proposition et réponse en commentaire;

        if (11. Proposition de mesures acceptee ?) then (Oui)

            |Safety|

            :12. Mise a jour des mesures;

            stop

        else (Non)

            |Management|

            stop

        endif

else (Non)

        |Safety|
        stop

endif

@enduml
